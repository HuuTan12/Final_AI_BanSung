classDiagram
  class Direction {
    <<enumeration>>
    UP
    DOWN
    LEFT
    RIGHT
  }

  class Action {
    <<enumeration>>
    MOVE_UP
    MOVE_DOWN
    MOVE_LEFT
    MOVE_RIGHT
    FIRE
    STAY
    +get_move_direction(action)$ Direction
  }

  class GameEntity {
    <<abstract>>
    +int x
    +int y
    +int hp
    +is_alive() bool
    +take_damage(damage) void
  }

  class Tank {
    +int INITIAL_HP = 6
    +int player_id
    +Direction direction
    +clone() Tank
  }

  class Base {
    +int INITIAL_HP = 9
    +int player_id
    +clone() Base
  }

  class Wall {
    +int INITIAL_HP = 3
    +clone() Wall
  }

  class Bullet {
    +int SPEED = 3
    +int x
    +int y
    +Direction direction
    +int owner_id
    +bool is_active
  }

  class GameState {
    +int width
    +int height
    +int current_player
    +int cycle_count
    +dict tanks
    +dict bases
    +dict walls
    +list bullets
    +get_legal_actions(player_id) list
    +is_terminal(max_cycles) bool
    +get_winner(max_cycles) int
    +clone() GameState
  }

  class GameRules {
    +apply_action(state, action)$ GameState
    +step_bullets_one_cell(state)$ list
  }

  class BaseAgent {
    <<abstract>>
    +str name
    +int player_id
    +SearchStats stats
    +choose_action(state)* Action
    +reset_stats() void
  }

  class MinimaxAgent {
    -int depth
    +choose_action(state) Action
    -_max_value(state, d) float
    -_min_value(state, d) float
  }

  class AlphaBetaAgent {
    -int depth
    +choose_action(state) Action
    -_max_value(state, d, alpha, beta) float
    -_min_value(state, d, alpha, beta) float
  }

  class HeuristicMinimaxAgent {
    -int depth
    -TankEvaluator evaluator
    +choose_action(state) Action
  }

  class HeuristicAlphaBetaAgent {
    -int depth
    -TankEvaluator evaluator
    +choose_action(state) Action
    -_order_moves(state, actions, player_id) list
  }

  class IterativeDeepeningAgent {
    -int max_depth
    -float time_limit
    -dict transposition_table
    +choose_action(state) Action
  }

  class TankEvaluator {
    +evaluate(state, player_id)$ float
    +get_tactical_distance(pos1, pos2, state)$ int
    +has_line_of_sight(from_pos, to_pos, state)$ bool
  }

  class AgentLoader {
    +load_agent_from_file(py_file_path)$ BaseAgent
    +discover_external_agents(dir_path)$ list
  }

  class TankTournament {
    -int max_cycles
    +run_single_move_benchmark(depths) dict
    +run_tournament() dict
    +export_tables() str
  }

  class TankGameGUI {
    -GameState state
    -BaseAgent agent0
    -BaseAgent agent1
    +run() void
    +animate_turn(prev_state, action, next_state) void
    +render(state) void
  }

  GameEntity <|-- Tank
  GameEntity <|-- Base
  GameEntity <|-- Wall
  GameState *-- Tank
  GameState *-- Base
  GameState *-- Wall
  GameState *-- Bullet
  GameRules ..> GameState
  BaseAgent <|-- MinimaxAgent
  BaseAgent <|-- AlphaBetaAgent
  BaseAgent <|-- HeuristicMinimaxAgent
  BaseAgent <|-- HeuristicAlphaBetaAgent
  BaseAgent <|-- IterativeDeepeningAgent
  HeuristicMinimaxAgent ..> TankEvaluator
  HeuristicAlphaBetaAgent ..> TankEvaluator
  IterativeDeepeningAgent ..> TankEvaluator
  AgentLoader ..> BaseAgent
  TankTournament ..> BaseAgent
  TankTournament ..> GameState
  TankGameGUI ..> GameState
  TankGameGUI ..> BaseAgent
