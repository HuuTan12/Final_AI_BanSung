@startuml Task2_Tank_ClassDiagram
!theme plain
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11

title Task 2: Tank Battle Game - Biểu đồ Lớp chi tiết (Class Diagram OOP)

package "task2_tank.engine" {
    enum Direction {
        UP
        DOWN
        LEFT
        RIGHT
    }

    enum Action {
        MOVE_UP
        MOVE_DOWN
        MOVE_LEFT
        MOVE_RIGHT
        FIRE
        STAY
        + {static} get_move_direction(action: Action) : Optional[Direction]
    }

    abstract class GameEntity {
        + x : int
        + y : int
        + hp : int
        + is_alive() : bool
        + take_damage(damage: int) : void
    }

    class Tank {
        + {static} INITIAL_HP : int = 6
        + player_id : int
        + direction : Direction
        + clone() : Tank
    }

    class Base {
        + {static} INITIAL_HP : int = 9
        + player_id : int
        + clone() : Base
    }

    class Wall {
        + {static} INITIAL_HP : int = 3
        + clone() : Wall
    }

    class Bullet {
        + {static} SPEED : int = 3
        + x : int
        + y : int
        + direction : Direction
        + owner_id : int
        + is_active : bool
        + clone() : Bullet
    }

    class GameState {
        + width : int
        + height : int
        + current_player : int
        + cycle_count : int
        + tanks : Dict[int, Tank]
        + bases : Dict[int, Base]
        + walls : Dict[Tuple[int, int], Wall]
        + bullets : List[Bullet]
        + get_legal_actions(player_id: int) : List[Action]
        + is_terminal(max_cycles: int) : bool
        + get_winner(max_cycles: int) : Optional[int]
        + clone() : GameState
    }

    class GameRules {
        + {static} apply_action(state: GameState, action: Action) : GameState
        + {static} step_bullets_one_cell(state: GameState) : List[Tuple]
    }
}

package "task2_tank.agents" {
    class SearchStats <<dataclass>> {
        + nodes_explored : int
        + prunes_count : int
        + search_time : float
        + max_depth_reached : int
        + chosen_action : Optional[Action]
    }

    abstract class BaseAgent {
        + name : str
        + player_id : int
        + stats : SearchStats
        + {abstract} choose_action(state: GameState) : Action
        + reset_stats() : void
    }

    class MinimaxAgent {
        - depth : int
        + choose_action(state: GameState) : Action
        - _max_value(state: GameState, depth: int) : float
        - _min_value(state: GameState, depth: int) : float
    }

    class AlphaBetaAgent {
        - depth : int
        + choose_action(state: GameState) : Action
        - _max_value(state: GameState, depth: int, alpha: float, beta: float) : float
        - _min_value(state: GameState, depth: int, alpha: float, beta: float) : float
    }

    class HeuristicMinimaxAgent {
        - depth : int
        - evaluator : TankEvaluator
        + choose_action(state: GameState) : Action
    }

    class HeuristicAlphaBetaAgent {
        - depth : int
        - evaluator : TankEvaluator
        + choose_action(state: GameState) : Action
        - _order_moves(state: GameState, actions: List[Action], player_id: int) : List[Action]
    }

    class IterativeDeepeningAgent {
        - max_depth : int
        - time_limit : float
        - transposition_table : dict
        + choose_action(state: GameState) : Action
    }

    class TankEvaluator {
        + {static} evaluate(state: GameState, player_id: int) : float
        + {static} get_tactical_distance(pos1: Tuple, pos2: Tuple, state: GameState) : int
        + {static} has_line_of_sight(from_pos: Tuple, to_pos: Tuple, state: GameState) : bool
    }
}

package "task2_tank.agent_loader" {
    class AgentLoader {
        + {static} load_agent_from_file(py_file_path: str) : BaseAgent
        + {static} discover_external_agents(dir_path: str) : List[BaseAgent]
    }
}

package "task2_tank.ui" {
    class TankGameGUI {
        - state : GameState
        - agent0 : BaseAgent
        - agent1 : BaseAgent
        + run() : void
        + animate_turn(prev_state: GameState, action: Action, next_state: GameState) : void
        + render(state: GameState) : void
    }
}

' Inheritance & Associations
GameEntity <|-- Tank
GameEntity <|-- Base
GameEntity <|-- Wall

GameState *-- Tank
GameState *-- Base
GameState *-- Wall
GameState *-- Bullet

GameRules ..> GameState

BaseAgent <|-- MinimaxAgent
BaseAgent <|-- AlphaBetaAgent
BaseAgent <|-- HeuristicMinimaxAgent
BaseAgent <|-- HeuristicAlphaBetaAgent
BaseAgent <|-- IterativeDeepeningAgent

BaseAgent ..> SearchStats : "ghi nhận số liệu"
HeuristicMinimaxAgent ..> TankEvaluator : "đánh giá hàm heuristic"
HeuristicAlphaBetaAgent ..> TankEvaluator : "đánh giá & sắp xếp nhánh"
IterativeDeepeningAgent ..> TankEvaluator : "đánh giá heuristic"

AgentLoader ..> BaseAgent : "nạp động file bot .py"
TankGameGUI ..> GameState : "hiển thị đồ họa"
TankGameGUI ..> BaseAgent : "điều khiển lượt đi"

@enduml
